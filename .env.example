# Copy to .env and fill in real values. .env is gitignored; this file is not —
# it documents which environment variables the project expects, with no real secrets.

# Long random string, e.g. `openssl rand -hex 32`. Required on every request
# as `Authorization: Bearer <value>`. Never commit a real value.
SYNC_SHARED_SECRET=

# Root directory for all persistent server data (raw/, db.sqlite3, logs/).
DATA_ROOT=./data

# Port the app binds to on 127.0.0.1 (never 0.0.0.0 — see docs/sync-ingestion/SPEC.md).
PORT=8420

# Optional off-box mirror for the data/raw/ backup git repo (docs/backup/README.md).
# A bare repo on another disk, or a private GitHub/Gitea URL with a deploy key. When set,
# every successful commit is followed by a best-effort `git push <remote> HEAD:main` — a
# push failure is logged, never fatal. Leave empty to disable the mirror.
BACKUP_GIT_REMOTE=

# Not env-configurable (hardcoded in app/config.py): ASSUMED_BIRTH_YEAR,
# ASSUMED_HEIGHT_CM, ASSUMED_SEX — placeholder profile inputs for the Tanaka/Gulati
# max-HR average and the Mifflin-St Jeor maintenance-calorie fallback. They silently
# influence the dashboard and maintenance estimates, so know they exist.
