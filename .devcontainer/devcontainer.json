{
  "name": "MyGymApp Sync Server",

  // mise (see .mise.toml) manages the pinned Python version inside the container.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",

  "onCreateCommand": "curl https://mise.run | sh && echo 'eval \"$(~/.local/bin/mise activate bash)\"' >> ~/.bashrc",

  // After mise installs Python, install project deps in editable mode.
  "postCreateCommand": "~/.local/bin/mise install && pip install -e '.[dev]'",

  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },

  "forwardPorts": [8420]
}
